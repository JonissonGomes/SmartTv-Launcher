# TMDB — https://www.themoviedb.org/settings/api
# Preferível: API Read Access Token (Bearer). A API Key funciona como fallback.

# API Read Access Token (JWT) — Authorization: Bearer ...
VITE_TMDB_TOKEN=

# API Key (v3) — query ?api_key=... (opcional se o token estiver preenchido)
VITE_TMDB_API_KEY=

# TypeSafe Jev — https://docs.typesafe.ai
# SOMENTE no servidor (npm run dev). Nunca use prefixo VITE_ (não vai para a TV).
TYPESAFE_API_KEY=

# Auth do launcher (Google Device Code via auth-server)
# Dev: deixe vazio para usar proxy Vite → http://127.0.0.1:8787
# TV/prod: URL pública do Render (sem barra no final)
VITE_AUTH_API_URL=

# Opcional no Vite: sobrescreve o upstream do proxy /api/auth
# AUTH_API_UPSTREAM=http://127.0.0.1:8787

# Origem LAN para QR de Jogos/Espelhar (se /__lan escolher IP errado)
# Ex.: VITE_DEV_LAN_ORIGIN=http://192.168.18.23:5173
# VITE_DEV_LAN_ORIGIN=

# Builds web-recomp locais (ISO sua; launcher só abre a URL). Portas = serve padrão.
# VITE_RECOMP_URL_GOW_COO=http://192.168.18.23:8613
# VITE_RECOMP_URL_GOW_GOS=http://192.168.18.23:8614
# VITE_RECOMP_URL_GT4=http://192.168.18.23:8620
# VITE_RECOMP_URL_GOW2=http://192.168.18.23:8621
