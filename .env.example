# TMDB — https://www.themoviedb.org/settings/api
# Preferível: API Read Access Token (Bearer). A API Key funciona como fallback.

# API Read Access Token (JWT) — Authorization: Bearer ...
VITE_TMDB_TOKEN=

# API Key (v3) — query ?api_key=... (opcional se o token estiver preenchido)
VITE_TMDB_API_KEY=

# TypeSafe Jev — https://docs.typesafe.ai
# SOMENTE no servidor (npm run dev). Nunca use prefixo VITE_ (não vai para a TV).
TYPESAFE_API_KEY=
