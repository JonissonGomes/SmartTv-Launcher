# Porta local (Render injeta PORT)
PORT=8787

# Origens CORS (launcher em dev + TV). Separar por vírgula.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Google Cloud Console → APIs & Services → Credentials
# Tipo recomendado: "TVs and Limited Input devices"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Segredo HS256 da API (gere com: openssl rand -base64 48)
JWT_SECRET=

# Emissor/audiência do JWT (opcional)
JWT_ISSUER=smarttv-launcher
JWT_AUDIENCE=smarttv-launcher

# Acesso em minutos / refresh em dias
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=30

# Só local/Simulator: 1 = login demo sem Google (NUNCA em produção)
AUTH_DEV_BYPASS=0
